{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "postfix: debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/postfix/postfix/postfix.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "cmake: build (postfix)",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
